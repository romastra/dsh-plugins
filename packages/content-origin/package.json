{
  "name": "@local/content-origin",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Local AI-content screening: C2PA signature validation, image and Russian text classifiers; explicit SynthID limits",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "worker.py",
    "requirements*.txt",
    "models.lock.json",
    "setup_assets.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  }
}
